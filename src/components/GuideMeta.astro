---
import coverage from '../../quality/coverage.json';
interface Props { id: string; }
const { id } = Astro.props;
const guide = coverage.guides.find((item) => item.id === id);
const verified = guide?.qualification === 'verified';
const partial = guide?.qualification === 'partial';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const supportedVersion = id.startsWith('sdk/') ? 'SDK 0.1.2' : 'Current beta console';
---
<div data-pagefind-ignore class:list={['guide-meta', { 'guide-pending': !verified }]}>
  <span>{supportedVersion}</span>
  <span aria-hidden="true">·</span>
  <span>{guide?.role ?? 'See prerequisites below'}</span>
  <span aria-hidden="true">·</span>
  <span>{verified ? `Walkthrough verified ${guide?.verifiedAt ?? '2026-11-12'}` : partial ? 'Walkthrough partly verified' : 'Walkthrough verification in progress'}</span>
  <a href={`${base}/reference/verification/`}>Verification details</a>
</div>
{!verified && <aside data-pagefind-ignore class="qualification-note">{partial ? guide?.validationStatus : 'The instructions below have been checked against the implementation. Live walkthrough and screenshot qualification are still in progress; check the verification record before relying on an unverified step.'}</aside>}
