---
import wordmark from '../assets/martian-wordmark.svg?raw';
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a class="martian-brand" href={siteTitleHref} aria-label="Martian Security — customer documentation">
  <span class="martian-brand-mark" aria-hidden="true"></span>
  <span class="martian-brand-type">
    <span class="martian-brand-wordmark" set:html={wordmark} />
    <span class="martian-brand-caption">Customer documentation</span>
  </span>
</a>
